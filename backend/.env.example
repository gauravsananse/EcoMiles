# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/green_credits_ev?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/green_credits_ev

# JWT Authentication Secret
JWT_SECRET=green_credits_jwt_super_secret_signing_key_2026_secure!

# Indian Vehicle RC Verification Provider Configuration
# Supported Options:
# 1. 'surepass'      -> Surepass Vahan API (requires VEHICLE_API_KEY)
# 2. 'sandbox_co'    -> Sandbox.co.in RC Search API (requires VEHICLE_API_KEY & VEHICLE_API_SECRET)
# 3. 'generic'       -> Generic RC REST endpoint (requires VEHICLE_API_URL & VEHICLE_API_KEY)
# 4. 'sandbox'       -> Development Sandbox Mode (built-in simulation testbed for offline testing)
VEHICLE_API_PROVIDER=sandbox

# Provider API Credentials (Never commit real keys to public git repositories)
VEHICLE_API_URL=https://kyc-api.surepass.io/api/v1/rc/rc-full
VEHICLE_API_KEY=YOUR_VEHICLE_API_KEY
VEHICLE_API_SECRET=YOUR_VEHICLE_API_SECRET
